# Plantilla de /etc/syncpass/syncpass.env en EC2 (la crea deploy/ec2-jdk-setup.sh). No publicar valores reales.
# Supabase > Connect > Session pooler. Convertir la URI postgres a JDBC y exigir TLS.
DATABASE_URL=jdbc:postgresql://YOUR-POOLER.supabase.com:5432/postgres?sslmode=require&currentSchema=syncpass
DATABASE_USER=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=replace-with-supabase-database-password

# La API llama a Cognito para registro/login y valida los tokens con este issuer.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_2C9bbmKGd
COGNITO_CLIENT_ID=677bhbj1qg892bmlk2pr1h6had
AWS_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000,https://web-react-nu-nine.vercel.app

# El JAR solo escucha en local; Caddy publica HTTPS hacia API Gateway.
SERVER_ADDRESS=127.0.0.1
